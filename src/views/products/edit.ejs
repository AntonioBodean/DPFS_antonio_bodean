<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head.ejs') %>

    <body>
        <div class="site-shell">
            <a class="skip-link" href="#contenido-principal">
                Saltar al contenido principal
            </a>

            <%- include('../partials/header.ejs') %>

                <main id="contenido-principal">
                    <section class="auth-section" aria-labelledby="edit-product-title">
                        <div class="container auth-section__content">
                            <header class="auth-heading">
                                <p class="eyebrow">Administración</p>
                                <h1 id="edit-product-title">Editar producto</h1>
                                <p>Actualizá la información de <strong>
                                        <%= product.name %>
                                    </strong>.</p>
                            </header>

                            <form class="auth-card product-form" action="/products/<%= product.id %>?_method=PUT"
                                method="post" enctype="multipart/form-data" data-validation="product" data-image-required="false" novalidate>
                                <div class="form-field">
                                    <label for="product-name">Nombre del producto</label>
                                    <input id="product-name" class="<%= errors.name ? 'form-field__error' : '' %>" type="text" name="name" value="<%= product.name %>"
                                        required>
                                    <% if (errors.name) { %><small class="form-field__error"><%= errors.name %></small><% } %>
                                </div>

                                <div class="form-field">
                                    <label for="product-description">Descripción</label>
                                    <textarea id="product-description" class="<%= errors.description ? 'form-field__error' : '' %>" style="width: 100%;" name="description"
                                        rows="5"><%= product.description %></textarea>
                                    <% if (errors.description) { %><small class="form-field__error"><%= errors.description %></small><% } %>
                                </div>

                                <div class="form-field">
                                    <label>Imagen actual</label>

                                    <img class="product-form__current-image" src="/images/<%= product.image %>"
                                        alt="<%= product.name %>">

                                    <label for="product-image">
                                        Reemplazar imagen <span>(opcional)</span>
                                    </label>

                                    <input id="product-image" class="<%= errors.image ? 'form-field__error' : '' %>" type="file" name="image" accept=".jpg,.jpeg,.png,.gif">
                                    <% if (errors.image) { %><small class="form-field__error"><%= errors.image %></small><% } %>
                                </div>

                                <div class="form-field">
                                    <label for="product-category">Categoría</label>
                                    <select id="product-category" class="<%= errors.categoryId ? 'form-field__error' : '' %>" name="categoryId" required>
                                        <% categories.forEach(category => { %>
                                            <option value="<%= category.id %>" <%= product.categoryId === category.id ? 'selected' : '' %>>
                                                <%= category.name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                    <% if (errors.categoryId) { %><small class="form-field__error"><%= errors.categoryId %></small><% } %>
                                </div>

                                <div class="form-field">
                                    <label for="product-brand">Marca</label>
                                    <input id="product-brand" class="<%= errors.brand ? 'form-field__error' : '' %>" type="text" name="brand" value="<%= product.brand %>"
                                        required>
                                    <% if (errors.brand) { %><small class="form-field__error"><%= errors.brand %></small><% } %>
                                </div>

                                <div class="form-field">
                                    <label for="product-colors">
                                        Colores <span>(opcional)</span>
                                    </label>
                                    <input id="product-colors" type="text" name="colors"
                                        value="<%= product.colors.join(', ') %>" placeholder="Ej.: rojo, azul, gris">
                                </div>

                                <div class="form-field">
                                    <label for="product-stock">Stock disponible</label>
                                    <input id="product-stock" class="<%= errors.stock ? 'form-field__error' : '' %>" type="number" name="stock" min="0" step="1"
                                        value="<%= product.stock %>" required>
                                    <% if (errors.stock) { %><small class="form-field__error"><%= errors.stock %></small><% } %>
                                </div>

                                <div class="form-field">
                                    <label for="product-price">Precio</label>
                                    <input id="product-price" class="<%= errors.price ? 'form-field__error' : '' %>" type="number" name="price" min="0" step="0.01"
                                        value="<%= product.price %>" required>
                                    <% if (errors.price) { %><small class="form-field__error"><%= errors.price %></small><% } %>
                                </div>

                                <button class="button button--primary auth-submit" type="submit">
                                    Guardar cambios
                                </button>
                                <div class="auth-switch auth-switch--cancel">
                                    <a href="/products">Cancelar y volver al listado</a>
                                </div>
                            </form>
                            <form class="auth-product delete-product-form" action="/products/<%= product.id %>?_method=DELETE" method="post" onsubmit="return confirm('¿Seguro que querés eliminar este producto?');">
                                <button class="button button--danger button--full" type="submit">Eliminar producto</button>
                            </form>
                        </div>
                    </section>

                    <%- include('../partials/newsletter.ejs') %>
                </main>

                <%- include('../partials/footer.ejs') %>
                <script src="/js/form-validation.js" defer></script>
        </div>
    </body>

</html>
