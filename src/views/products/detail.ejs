<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head.ejs') %>

    <body>
        <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>

        <%- include('../partials/header.ejs') %>

            <main id="contenido-principal">
                <div class="container">
                    <nav class="breadcrumbs" aria-label="Ruta de navegación">
                        <ol>
                            <li><a href="/">Inicio</a></li>
                            <li><a href="/products">Productos</a></li>
                            <li aria-current="page"><%= product.name %></li>
                        </ol>
                    </nav>

                    <section class="product-detail" aria-labelledby="product-title">
                        <div class="product-detail__gallery">
                            <input class="favorite-toggle sr-only" type="checkbox" id="favorite-product">
                            <label class="favorite-button" for="favorite-product">
                                <span aria-hidden="true">♡</span>
                                <span class="sr-only">Agregar <%= product.name %> a favoritos</span>
                            </label>
                            <img src="/images/<%= product.image %>" alt="<%= product.name %>">
                        </div>

                        <div class="product-detail__info">
                            <p class="eyebrow"><%= product.category %></p>
                            <h1 id="product-title"><%= product.name %></h1>
                            <p class="product-detail__brand"><%= product.brand %></p>

                            <% if (product.stock > 0) { %>
                                <p class="product-detail__stock product-card__stock product-card__stock--available">
                                    <%= product.stock %> unidades disponibles
                                </p>
                            <% } else { %>
                                <p class="product-detail__stock product-card__stock">Sin stock</p>
                            <% } %>

                            <p class="product-detail__price">
                                <small>Precio final</small>$ <%= product.price.toLocaleString('es-AR') %>
                            </p>
                            <p class="product-detail__installments">Hasta 12 cuotas sin interés</p>

                            <form class="purchase-form" action="/products/cart">
                                <label for="quantity">Cantidad</label>
                                <div class="purchase-form__row">
                                    <input id="quantity" name="quantity" type="number" min="1"
                                        max="<%= product.stock %>" value="1">
                                    <button class="button button--primary" type="submit"
                                        <%= product.stock === 0 ? 'disabled' : '' %>>
                                        Agregar al carrito
                                    </button>
                                </div>
                            </form>

                            <div class="product-card__actions">
                                <a class="button button--secondary" href="/products/<%= product.id %>/edit">
                                    Editar producto
                                </a>
                            </div>
                        </div>
                    </section>

                    <section class="product-copy" aria-labelledby="description-title">
                        <div class="product-copy__content">
                            <div>
                                <h2 id="description-title">Descripción</h2>
                                <p><%= product.description %></p>
                            </div>
                            <div>
                                <h2>Características</h2>
                                <dl class="feature-list">
                                    <div><dt>Categoría</dt><dd><%= product.category %></dd></div>
                                    <div><dt>Marca</dt><dd><%= product.brand %></dd></div>
                                    <div>
                                        <dt>Colores</dt>
                                        <dd><%= product.colors.length ? product.colors.join(', ') : 'No aplica' %></dd>
                                    </div>
                                    <div><dt>Stock</dt><dd><%= product.stock %> unidades</dd></div>
                                </dl>
                            </div>
                        </div>
                    </section>
                </div>

                <% if (relatedProducts.length) { %>
                    <section class="section section--soft related-products" aria-labelledby="related-title">
                        <div class="container">
                            <header class="section-heading">
                                <div>
                                    <p class="eyebrow">Completá tu proyecto</p>
                                    <h2 id="related-title">Productos relacionados</h2>
                                </div>
                                <a class="text-link" href="/products">Ver todos <span aria-hidden="true">→</span></a>
                            </header>

                            <div class="related-products__grid">
                                <% relatedProducts.forEach(relatedProduct => { %>
                                    <article class="product-card">
                                        <figure class="product-card__image">
                                            <img src="/images/<%= relatedProduct.image %>"
                                                alt="<%= relatedProduct.name %>" loading="lazy">
                                        </figure>
                                        <div class="product-card__body">
                                            <p class="product-card__category"><%= relatedProduct.category %></p>
                                            <h3><%= relatedProduct.name %></h3>
                                            <p class="product-card__price">
                                                <small>Precio final</small>
                                                $ <%= relatedProduct.price.toLocaleString('es-AR') %>
                                            </p>
                                            <a class="button button--secondary"
                                                href="/products/<%= relatedProduct.id %>">Ver producto</a>
                                        </div>
                                    </article>
                                <% }) %>
                            </div>
                        </div>
                    </section>
                <% } %>

                <%- include('../partials/newsletter.ejs') %>
            </main>

            <%- include('../partials/footer.ejs') %>
    </body>

</html>
