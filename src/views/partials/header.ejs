<header class="site-header">
    <section class="header-main" aria-label="Cabecera principal">
        <div class="container header-main__content">
            <details class="mobile-menu">
                <summary aria-label="Abrir menú de navegación">
                    <span class="hamburger" aria-hidden="true"></span>
                    <span class="sr-only">Menú</span>
                </summary>
                <nav class="mobile-menu__panel" aria-label="Navegación móvil">
                    <form class="mobile-search" action="#" role="search">
                        <label class="sr-only" for="mobile-search">Buscar productos</label>
                        <input id="mobile-search" type="search" name="q" placeholder="¿Qué necesitás para tu obra?">
                        <button type="submit">Buscar</button>
                    </form>
                    <a href="/">Inicio</a>
                    <a href="/#categorias">Categorías</a>
                    <a href="/products">Productos</a>
                    <a href="/#promociones">Ofertas</a>
                    <a href="/users/login">Ingresar</a>
                    <a href="/users/register">Crear cuenta</a>
                </nav>
            </details>

            <a class="brand" href="/" aria-label="ConstruMarket, ir al inicio">
                <img src="/images/construmarket-logo.png" alt="ConstruMarket, todo para tu obra en un solo lugar">
            </a>

            <form class="header-search" action="#" role="search">
                <label class="sr-only" for="desktop-search">Buscar productos</label>
                <input id="desktop-search" type="search" name="q" placeholder="¿Qué necesitás para tu obra?">
                <button type="submit" aria-label="Buscar">Buscar</button>
            </form>

            <nav class="header-actions" aria-label="Accesos de usuario">
                <a href="/users/login" class="header-action">
                    <span class="header-action__icon" aria-hidden="true">●</span>
                    <span><small>Hola</small>Ingresar</span>
                </a>
                <a href="/products/cart" class="header-action header-action--cart">
                    <span class="cart-icon" aria-hidden="true">▰</span>
                    <span class="header-action__label"><small>Tu compra</small>Carrito (0)</span>
                </a>
            </nav>
        </div>
    </section>

    <nav class="desktop-nav" aria-label="Navegación principal">
        <div class="container desktop-nav__content">
            <a class="desktop-nav__categories" href="/#categorias">
                <span class="hamburger hamburger--small" aria-hidden="true"></span>
                Categorías
            </a>
            <ul>
                <li><a href="/">Inicio</a></li>
                <li><a href="/products">Productos</a></li>
                <li><a href="/#promociones">Ofertas</a></li>
                <li><a href="/#beneficios">Servicios</a></li>
                <li><a href="/users/register">Crear cuenta</a></li>
                <li><a href="#ayuda">Ayuda</a></li>
            </ul>
        </div>
    </nav>
</header>