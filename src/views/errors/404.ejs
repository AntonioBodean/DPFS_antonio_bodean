<!DOCTYPE html>
<html lang="es">

<%- include('../partials/head.ejs') %>

    <body>
        <div class="site-shell">
            <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>

            <%- include('../partials/header.ejs') %>

                <main id="contenido-principal" class="error-page">
                    <section class="container error-page__content" aria-labelledby="error-title">
                        <p class="error-page__code" aria-hidden="true">404</p>
                        <p class="eyebrow">Algo no salió como esperábamos</p>
                        <h1 id="error-title"><%= heading %></h1>
                        <p class="error-page__message"><%= message %></p>
                        <a class="button button--primary" href="<%= backUrl %>"><%= backLabel %></a>
                    </section>
                </main>

                <%- include('../partials/footer.ejs') %>
        </div>
    </body>

</html>
