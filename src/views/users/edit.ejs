<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head.ejs') %>
<body>
    <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>
    <%- include('../partials/header.ejs') %>
    <main id="contenido-principal" class="auth-main">
        <section class="auth-section">
            <div class="container auth-section__content">
                <header class="auth-heading"><p class="eyebrow">Administración</p><h1>Editar usuario</h1></header>
                <form class="auth-card" action="/users/<%= user.id %>?_method=PUT" method="post" enctype="multipart/form-data">
                    <div class="form-field"><label for="first-name">Nombre</label><input id="first-name" name="firstName" value="<%= user.firstName %>" required>
                        <% if (errors.firstName) { %><small class="form-field__error"><%= errors.firstName %></small><% } %></div>
                    <div class="form-field"><label for="last-name">Apellido</label><input id="last-name" name="lastName" value="<%= user.lastName %>" required>
                        <% if (errors.lastName) { %><small class="form-field__error"><%= errors.lastName %></small><% } %></div>
                    <div class="form-field"><label for="email">Correo</label><input id="email" type="email" name="email" value="<%= user.email %>" required>
                        <% if (errors.email) { %><small class="form-field__error"><%= errors.email %></small><% } %></div>
                    <div class="form-field"><label for="phone">Teléfono</label><input id="phone" name="phone" value="<%= user.phone || '' %>"></div>
                    <div class="form-field"><label for="role">Tipo de cuenta</label><select id="role" name="roleId">
                        <% roles.forEach(role => { %><option value="<%= role.id %>" <%= Number(user.roleId) === role.id ? 'selected' : '' %>><%= role.name %></option><% }) %>
                    </select></div>
                    <div class="form-field"><label for="image">Reemplazar avatar <span>(opcional)</span></label><input id="image" type="file" name="image" accept="image/*"></div>
                    <div class="form-field"><label for="password">Nueva contraseña <span>(opcional)</span></label><input id="password" type="password" name="password" minlength="8">
                        <% if (errors.password) { %><small class="form-field__error"><%= errors.password %></small><% } %></div>
                    <div class="form-field"><label for="confirm-password">Confirmar contraseña</label><input id="confirm-password" type="password" name="confirmPassword">
                        <% if (errors.confirmPassword) { %><small class="form-field__error"><%= errors.confirmPassword %></small><% } %></div>
                    <button class="button button--primary auth-submit" type="submit">Guardar cambios</button>
                </form>
                <form class="delete-product-form" action="/users/<%= user.id %>?_method=DELETE" method="post" onsubmit="return confirm('¿Seguro que querés eliminar este usuario?');">
                    <button class="button button--danger button--full" type="submit">Eliminar usuario</button>
                </form>
            </div>
        </section>
    </main>
    <%- include('../partials/footer.ejs') %>
</body>
</html>
