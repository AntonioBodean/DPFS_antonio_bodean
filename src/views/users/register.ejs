<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head.ejs') %>

    <body>
        <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>

        <%- include('../partials/header.ejs') %>

            <main id="contenido-principal" class="auth-main">
                <section class="auth-section" aria-labelledby="register-title">
                    <div class="container auth-section__content">
                        <header class="auth-heading">
                            <p class="eyebrow">Sumate a ConstruMarket</p>
                            <h1 id="register-title">Crear cuenta</h1>
                            <p>Completá tus datos para empezar a comprar todo para tu obra.</p>
                        </header>

                        <form class="auth-card" action="#" method="post">
                            <div class="form-field">
                                <label for="full-name" class="form-field__label">Nombre completo</label>
                                <input required id="full-name" class="form-field__error" type="text" name="fullName"
                                    autocomplete="name" placeholder="Ej.: Ana Martínez">
                                <small id="full-name-help" class="form-field__error">El nombre completo debe contener al
                                    menos 3 caracteres.</small>
                            </div>
                            <div class="form-field">
                                <label for="register-email">Correo electrónico</label>
                                <input id="register-email" class="form-field__error" type="email" name="email"
                                    autocomplete="email" inputmode="email" placeholder="nombre@correo.com">
                                <small id="register-email-help" class="form-field__error">El correo electrónico no es
                                    válido.</small>
                            </div>
                            <div class="form-field">
                                <label for="phone">Teléfono <span>(opcional)</span></label>
                                <input id="phone" class="form-field__error" type="tel" name="phone" autocomplete="tel"
                                    inputmode="tel" placeholder="Ej.: 11 2345 6789">
                                <small id="phone-help" class="form-field__error">El teléfono no es válido.</small>
                            </div>
                            <div class="form-field">
                                <label for="register-password">Contraseña</label>
                                <input id="register-password" type="password" name="password"
                                    autocomplete="new-password" aria-describedby="password-help">
                                <small id="password-help">Usá al menos 8 caracteres.</small>
                            </div>
                            <div class="form-field">
                                <label for="confirm-password">Confirmar contraseña</label>
                                <input id="confirm-password" class="form-field__error" type="password"
                                    name="confirmPassword" autocomplete="new-password">
                                <small id="confirm-password-help" class="form-field__error">Las contraseñas no
                                    coinciden.</small>
                            </div>
                            <label class="checkbox-field">
                                <input type="checkbox" name="terms">
                                <span>Acepto los <a href="#">Términos y condiciones</a> y la <a href="#">Política de
                                        privacidad</a>.</span>
                            </label>
                            <button class="button button--primary auth-submit" type="submit">Crear cuenta</button>
                            <div class="auth-switch">
                                <p>¿Ya tenés cuenta?</p>
                                <a href="/users/login">Iniciar sesión</a>
                            </div>
                        </form>
                    </div>
                </section>

                <%- include('../partials/newsletter.ejs') %>
            </main>

            <%- include('../partials/footer.ejs') %>
    </body>

</html>